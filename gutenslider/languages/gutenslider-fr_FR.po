#. Plugin Name of the plugin
#: eedee-gutenslider.php
msgid "Gutenslider — Slider Block for the Block Editor"
msgstr "Gutenslider — Bloc de diaporama pour l’éditeur de blocs"

#. Plugin URI of the plugin
#: eedee-gutenslider.php
msgid "https://gutenslider.org"
msgstr "https://gutenslider.org"

#. Description of the plugin
#: eedee-gutenslider.php
msgid "A slider block for images, videos and any blocks on top: carousels, hero sliders and fullscreen background sliders, with responsive settings."
msgstr "Un bloc de slider pour images, vidéos et tous les blocs par-dessus : carrousels, sliders d’en-tête et sliders d’arrière-plan plein écran, avec des réglages par appareil."

