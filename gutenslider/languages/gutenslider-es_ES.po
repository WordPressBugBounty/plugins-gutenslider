#. Plugin Name of the plugin
#: eedee-gutenslider.php
msgid "Gutenslider — Slider Block for the Block Editor"
msgstr "Gutenslider — Bloque de slider para el editor de bloques"

#. Plugin URI of the plugin
#: eedee-gutenslider.php
msgid "https://gutenslider.org"
msgstr "https://gutenslider.org"

#. Description of the plugin
#: eedee-gutenslider.php
msgid "A slider block for images, videos and any blocks on top: carousels, hero sliders and fullscreen background sliders, with responsive settings."
msgstr "Un bloque de slider para imágenes, vídeos y cualquier bloque encima: carruseles, sliders de cabecera y sliders de fondo a pantalla completa, con ajustes por dispositivo."

