{"translation-revision-date":"2026-09-28 10:24+0200","generator":"WP-CLI\/2.12.0","source":"build\/blocks\/slider\/index.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ja","plural-forms":"nplurals=1; plural=0;"},"Play video: %s":["\u52d5\u753b\u3092\u518d\u751f: %s"],"Play video":["\u52d5\u753b\u3092\u518d\u751f"],"Previous slide":["\u524d\u306e\u30b9\u30e9\u30a4\u30c9"],"Next slide":["\u6b21\u306e\u30b9\u30e9\u30a4\u30c9"],"Video file":["\u52d5\u753b\u30d5\u30a1\u30a4\u30eb"],"Desktop":["\u30c7\u30b9\u30af\u30c8\u30c3\u30d7"],"Tablet":["\u30bf\u30d6\u30ec\u30c3\u30c8"],"Mobile":["\u30e2\u30d0\u30a4\u30eb"],"Device":["\u30c7\u30d0\u30a4\u30b9"],"Settings marked with a device apply to the device selected here.":["\u30c7\u30d0\u30a4\u30b9\u306e\u5370\u304c\u4ed8\u3044\u305f\u8a2d\u5b9a\u306f\u3001\u3053\u3053\u3067\u9078\u629e\u3057\u305f\u30c7\u30d0\u30a4\u30b9\u306b\u9069\u7528\u3055\u308c\u307e\u3059\u3002"],"%1$s (%2$s)":["%1$s (%2$s)"],"None":["\u306a\u3057"],"Caption":["\u30ad\u30e3\u30d7\u30b7\u30e7\u30f3"],"Title \u2013 caption":["\u30bf\u30a4\u30c8\u30eb \u2013 \u30ad\u30e3\u30d7\u30b7\u30e7\u30f3"],"Title \u2013 caption \u2013 description":["\u30bf\u30a4\u30c8\u30eb \u2013 \u30ad\u30e3\u30d7\u30b7\u30e7\u30f3 \u2013 \u8aac\u660e"],"slider effect\u0004Slide":["\u30b9\u30e9\u30a4\u30c9"],"slider effect\u0004Fade":["\u30d5\u30a7\u30fc\u30c9"],"Not with this effect: the blocks stay on top.":["\u3053\u306e\u30a8\u30d5\u30a7\u30af\u30c8\u3067\u306f\u4f7f\u3048\u307e\u305b\u3093: \u30d6\u30ed\u30c3\u30af\u306f\u4e0a\u306b\u91cd\u306a\u308a\u307e\u3059\u3002"],"The image keeps the minimum height; the blocks take the room they need.":["\u753b\u50cf\u306f\u6700\u5c0f\u306e\u9ad8\u3055\u3092\u4fdd\u3061\u3001\u30d6\u30ed\u30c3\u30af\u306f\u5fc5\u8981\u306a\u5206\u3060\u3051\u5834\u6240\u3092\u53d6\u308a\u307e\u3059\u3002"],"Slides":["\u30b9\u30e9\u30a4\u30c9"],"Content":["\u30b3\u30f3\u30c6\u30f3\u30c4"],"The same blocks stay on top while the backgrounds change. Add them below the slides.":["\u80cc\u666f\u304c\u5207\u308a\u66ff\u308f\u3063\u3066\u3082\u540c\u3058\u30d6\u30ed\u30c3\u30af\u304c\u4e0a\u306b\u8868\u793a\u3055\u308c\u305f\u307e\u307e\u306b\u306a\u308a\u307e\u3059\u3002\u30b9\u30e9\u30a4\u30c9\u306e\u4e0b\u306b\u8ffd\u52a0\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Each slide has its own blocks.":["\u30b9\u30e9\u30a4\u30c9\u3054\u3068\u306b\u500b\u5225\u306e\u30d6\u30ed\u30c3\u30af\u3092\u6301\u3061\u307e\u3059\u3002"],"Per slide":["\u30b9\u30e9\u30a4\u30c9\u3054\u3068"],"Same on all":["\u5168\u30b9\u30e9\u30a4\u30c9\u5171\u901a"],"Blocks":["\u30d6\u30ed\u30c3\u30af"],"content placement\u0004On top":["\u753b\u50cf\u306e\u4e0a"],"content placement\u0004Below":["\u4e0b"],"content placement\u0004Above":["\u4e0a"],"Content width":["\u30b3\u30f3\u30c6\u30f3\u30c4\u5e45"],"The blocks line up with the theme's width; the background stays full width.":["\u30d6\u30ed\u30c3\u30af\u306f\u30c6\u30fc\u30de\u306e\u5e45\u306b\u305d\u308d\u3044\u3001\u80cc\u666f\u306f\u5168\u5e45\u306e\u307e\u307e\u3067\u3059\u3002"],"content width\u0004Full":["\u5168\u5e45"],"content width\u0004Wide":["\u30ef\u30a4\u30c9"],"content width\u0004Content":["\u30b3\u30f3\u30c6\u30f3\u30c4"],"This effect shows one slide at a time.":["\u3053\u306e\u30a8\u30d5\u30a7\u30af\u30c8\u3067\u306f\u30b9\u30e9\u30a4\u30c9\u30921\u679a\u305a\u3064\u8868\u793a\u3057\u307e\u3059\u3002"],"Width from content":["\u30b3\u30f3\u30c6\u30f3\u30c4\u306b\u5408\u308f\u305b\u305f\u5e45"],"Each slide is as wide as its image. Slides without media use their own width setting.":["\u5404\u30b9\u30e9\u30a4\u30c9\u306f\u753b\u50cf\u3068\u540c\u3058\u5e45\u306b\u306a\u308a\u307e\u3059\u3002\u30e1\u30c7\u30a3\u30a2\u306e\u306a\u3044\u30b9\u30e9\u30a4\u30c9\u306f\u500b\u5225\u306e\u5e45\u8a2d\u5b9a\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002"],"Slides in view":["\u8868\u793a\u3059\u308b\u30b9\u30e9\u30a4\u30c9\u6570"],"Slides per step":["1\u56de\u306b\u9032\u3080\u30b9\u30e9\u30a4\u30c9\u6570"],"Space between slides, px":["\u30b9\u30e9\u30a4\u30c9\u306e\u9593\u9694 (px)"],"Minimum height":["\u6700\u5c0f\u306e\u9ad8\u3055"],"Grow with the content":["\u30b3\u30f3\u30c6\u30f3\u30c4\u306b\u5408\u308f\u305b\u3066\u62e1\u5927"],"The slider takes the height of the slide on show.":["\u30b9\u30e9\u30a4\u30c0\u30fc\u306f\u8868\u793a\u4e2d\u306e\u30b9\u30e9\u30a4\u30c9\u306e\u9ad8\u3055\u306b\u5408\u308f\u305b\u307e\u3059\u3002"],"Full screen height":["\u5168\u753b\u9762\u306e\u9ad8\u3055"],"Effect":["\u30a8\u30d5\u30a7\u30af\u30c8"],"Motion":["\u52d5\u304d"],"Loop":["\u30eb\u30fc\u30d7"],"After the last slide comes the first.":["\u6700\u5f8c\u306e\u30b9\u30e9\u30a4\u30c9\u306e\u6b21\u306b\u6700\u521d\u306e\u30b9\u30e9\u30a4\u30c9\u3092\u8868\u793a\u3057\u307e\u3059\u3002"],"Random order":["\u30e9\u30f3\u30c0\u30e0\u306a\u9806\u756a"],"A new order on each visit, also on cached pages. The editor keeps the saved order.":["\u8a2a\u554f\u3054\u3068\u306b\u65b0\u3057\u3044\u9806\u756a\u306b\u306a\u308a\u307e\u3059\u3002\u30ad\u30e3\u30c3\u30b7\u30e5\u3055\u308c\u305f\u30da\u30fc\u30b8\u3067\u3082\u540c\u69d8\u3067\u3059\u3002\u30a8\u30c7\u30a3\u30bf\u30fc\u3067\u306f\u4fdd\u5b58\u3057\u305f\u9806\u756a\u306e\u307e\u307e\u3067\u3059\u3002"],"Center the active slide":["\u30a2\u30af\u30c6\u30a3\u30d6\u306a\u30b9\u30e9\u30a4\u30c9\u3092\u4e2d\u592e\u306b\u914d\u7f6e"],"Autoplay":["\u81ea\u52d5\u518d\u751f"],"Stops for visitors who prefer reduced motion.":["\u52d5\u304d\u3092\u6e1b\u3089\u3059\u8a2d\u5b9a\u306e\u8a2a\u554f\u8005\u306b\u306f\u505c\u6b62\u3057\u307e\u3059\u3002"],"Pause while the pointer is over the slider":["\u30dd\u30a4\u30f3\u30bf\u30fc\u304c\u30b9\u30e9\u30a4\u30c0\u30fc\u4e0a\u306b\u3042\u308b\u9593\u306f\u4e00\u6642\u505c\u6b62"],"Play videos when their slide shows":["\u30b9\u30e9\u30a4\u30c9\u304c\u8868\u793a\u3055\u308c\u305f\u3089\u52d5\u753b\u3092\u518d\u751f"],"For all video slides; a slide can set its own.":["\u3059\u3079\u3066\u306e\u52d5\u753b\u30b9\u30e9\u30a4\u30c9\u306b\u9069\u7528\u3002\u30b9\u30e9\u30a4\u30c9\u3054\u3068\u306b\u500b\u5225\u8a2d\u5b9a\u3082\u3067\u304d\u307e\u3059\u3002"],"Arrows":["\u77e2\u5370"],"Show on":["\u8868\u793a\u3059\u308b\u30c7\u30d0\u30a4\u30b9"],"Style":["\u30b9\u30bf\u30a4\u30eb"],"Size in px":["\u30b5\u30a4\u30ba (px)"],"Pagination":["\u30da\u30fc\u30b8\u30cd\u30fc\u30b7\u30e7\u30f3"],"Dividers":["\u533a\u5207\u308a"],"Dividers do not show with this effect.":["\u3053\u306e\u30a8\u30d5\u30a7\u30af\u30c8\u3067\u306f\u533a\u5207\u308a\u306f\u8868\u793a\u3055\u308c\u307e\u305b\u3093\u3002"],"Top":["\u4e0a"],"Bottom":["\u4e0b"],"divider\u0004None":["\u306a\u3057"],"Color":["\u8272"],"Flip horizontally":["\u5de6\u53f3\u53cd\u8ee2"],"Lightbox":["\u30e9\u30a4\u30c8\u30dc\u30c3\u30af\u30b9"],"Open images and videos in a lightbox":["\u753b\u50cf\u3068\u52d5\u753b\u3092\u30e9\u30a4\u30c8\u30dc\u30c3\u30af\u30b9\u3067\u958b\u304f"],"On click: the slide backgrounds, and Image and Video blocks on the slides. Not for slides with a link.":["\u30af\u30ea\u30c3\u30af\u3067\u958b\u304f: \u30b9\u30e9\u30a4\u30c9\u306e\u80cc\u666f\u3068\u3001\u30b9\u30e9\u30a4\u30c9\u4e0a\u306e\u753b\u50cf\u30fb\u52d5\u753b\u30d6\u30ed\u30c3\u30af\u3002\u30ea\u30f3\u30af\u4ed8\u304d\u306e\u30b9\u30e9\u30a4\u30c9\u306f\u9664\u304d\u307e\u3059\u3002"],"Look":["\u5916\u89b3"],"lightbox look\u0004Light":["\u30e9\u30a4\u30c8"],"lightbox look\u0004Dark":["\u30c0\u30fc\u30af"],"Slider ID (for custom CSS)":["\u30b9\u30e9\u30a4\u30c0\u30fc ID (\u30ab\u30b9\u30bf\u30e0 CSS \u7528)"],"Load the first image right away":["\u6700\u521d\u306e\u753b\u50cf\u3092\u3059\u3050\u306b\u8aad\u307f\u8fbc\u3080"],"For a slider at the top of the page. The first slider on a page does this anyway.":["\u30da\u30fc\u30b8\u4e0a\u90e8\u306b\u3042\u308b\u30b9\u30e9\u30a4\u30c0\u30fc\u5411\u3051\u3067\u3059\u3002\u30da\u30fc\u30b8\u5185\u306e\u6700\u521d\u306e\u30b9\u30e9\u30a4\u30c0\u30fc\u306f\u5e38\u306b\u3053\u306e\u52d5\u4f5c\u306b\u306a\u308a\u307e\u3059\u3002"],"Captions from the Media Library":["\u30e1\u30c7\u30a3\u30a2\u30e9\u30a4\u30d6\u30e9\u30ea\u306e\u30ad\u30e3\u30d7\u30b7\u30e7\u30f3"],"Adds a paragraph with the image texts to each image slide. You can edit it afterwards.":["\u753b\u50cf\u306e\u5404\u30b9\u30e9\u30a4\u30c9\u306b\u3001\u753b\u50cf\u306e\u30c6\u30ad\u30b9\u30c8\u3092\u542b\u3080\u6bb5\u843d\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002\u5f8c\u304b\u3089\u7de8\u96c6\u3067\u304d\u307e\u3059\u3002"],"Link images to the file":["\u753b\u50cf\u3092\u30d5\u30a1\u30a4\u30eb\u306b\u30ea\u30f3\u30af"],"The slider\u2019s lightbox is on and opens the images.":["\u30b9\u30e9\u30a4\u30c0\u30fc\u306e\u30e9\u30a4\u30c8\u30dc\u30c3\u30af\u30b9\u304c\u30aa\u30f3\u3067\u3001\u753b\u50cf\u3092\u958b\u304d\u307e\u3059\u3002"],"For lightbox plugins that open linked images. Slides with their own link keep it.":["\u30ea\u30f3\u30af\u3055\u308c\u305f\u753b\u50cf\u3092\u958b\u304f\u30e9\u30a4\u30c8\u30dc\u30c3\u30af\u30b9\u30d7\u30e9\u30b0\u30a4\u30f3\u5411\u3051\u3002\u72ec\u81ea\u306e\u30ea\u30f3\u30af\u304c\u3042\u308b\u30b9\u30e9\u30a4\u30c9\u306f\u305d\u306e\u307e\u307e\u3067\u3059\u3002"],"Show the slider on":["\u30b9\u30e9\u30a4\u30c0\u30fc\u3092\u8868\u793a\u3059\u308b\u30c7\u30d0\u30a4\u30b9"],"Arrow keys change slides":["\u77e2\u5370\u30ad\u30fc\u3067\u30b9\u30e9\u30a4\u30c9\u3092\u5207\u308a\u66ff\u3048"],"While the slider is on screen.":["\u30b9\u30e9\u30a4\u30c0\u30fc\u304c\u753b\u9762\u306b\u8868\u793a\u3055\u308c\u3066\u3044\u308b\u9593\u3002"],"Link to each slide":["\u5404\u30b9\u30e9\u30a4\u30c9\u3078\u306e\u30ea\u30f3\u30af"],"The page address follows the slide on show (#name), so a shared link opens that slide.":["\u30da\u30fc\u30b8\u306e\u30a2\u30c9\u30ec\u30b9\u304c\u8868\u793a\u4e2d\u306e\u30b9\u30e9\u30a4\u30c9\u306b\u5408\u308f\u305b\u3066\u5909\u308f\u308b (#name) \u305f\u3081\u3001\u5171\u6709\u3057\u305f\u30ea\u30f3\u30af\u3067\u305d\u306e