#. Plugin Name of the plugin
#: eedee-gutenslider.php
msgid "Gutenslider — Slider Block for the Block Editor"
msgstr "Gutenslider — Bloco de slider para o editor de blocos"

#. Plugin URI of the plugin
#: eedee-gutenslider.php
msgid "https://gutenslider.org"
msgstr "https://gutenslider.org"

#. Description of the plugin
#: eedee-gutenslider.php
msgid "A slider block for images, videos and any blocks on top: carousels, hero sliders and fullscreen background sliders, with responsive settings."
msgstr "Um bloco de slider para imagens, vídeos e quaisquer blocos por cima: carrosséis, sliders de destaque e sliders de fundo em tela cheia, com configurações por dispositivo."

