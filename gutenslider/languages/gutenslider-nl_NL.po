#. Plugin Name of the plugin
#: eedee-gutenslider.php
msgid "Gutenslider — Slider Block for the Block Editor"
msgstr "Gutenslider — Slider-blok voor de blok-editor"

#. Plugin URI of the plugin
#: eedee-gutenslider.php
msgid "https://gutenslider.org"
msgstr "https://gutenslider.org"

#. Description of the plugin
#: eedee-gutenslider.php
msgid "A slider block for images, videos and any blocks on top: carousels, hero sliders and fullscreen background sliders, with responsive settings."
